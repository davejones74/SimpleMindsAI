# --- SimpleMindsAI environment ---
# Phase 1 (62M) is complete; 3B training is Phase 2, perpetual learning Phase 3.
# The authoritative list of variables lives in `src/config.js`; this file is the
# reference example that must stay consistent with it (see docs/DEPLOYMENT.md).

# Python compute plane. The chat brain IS the Python student worker; there is no
# teacher fallback. `SMA_PYTHON`/`SMA_STORE` are also how Node finds the brain.
# SMA_PYTHON=python/python/.venv/Scripts/python.exe   # default: the checkout venv
# SMA_STORE=C:\Users\you\.sma\store                    # default: ~/.sma/store
SMA_DEVICE=auto            # auto | cpu | cuda

# Teacher / critic (external researcher & reviewer — NEVER the student's answer)
OLLAMA_ENDPOINT=http://localhost:11434
# On consumer rigs `:latest` is a 4-7GB distill, NOT the 671B MoE. The
# development rig pins the Gemma 4 Turbo teacher (see .env); this reference
# default stays a small distill so a bare checkout works without that model.
OLLAMA_MODEL=deepseek-r1:latest
# Optional pinned teacher identity: readiness reports whether the configured
# model tag resolves to exactly this digest (catches a silent re-tag/substitution).
# OLLAMA_MODEL_DIGEST=
OLLAMA_READINESS_TIMEOUT_MS=5000
# true => deterministic stub for every Ollama call (no GPU needed for smoke/tests)
OLLAMA_FIXTURE=false
# Critic model identifier — when set, overrides the teacher model
  # used specifically for critic scoring in ReviewScorer. When not set,
  # falls back to OLLAMA_MODEL for complete backward compatibility.
  # Set via CRITIC_MODEL env var; records its value in review provenance.
  CRITIC_MODEL=

# Storage. ARTICLE_DIR must be set explicitly: BUFFER_DIR is the LEGACY
# pair-buffer location used only for read-only detection, and the article store
# falls back to it when ARTICLE_DIR is unset. Leaving it unset therefore writes
# the live ledgers into the legacy directory, which makes the Observatory report
# "Legacy pair-buffer files detected" forever and hides the real store.
ARTICLE_DIR=./data/articles
BUFFER_DIR=./data/buffer
REGISTRY_DIR=./data/registry
SNAPSHOT_DIR=./data/snapshots
EVALUATION_DIR=./data/evaluation
PLAN_DIR=./data/plans
MODEL_DIR=./data/models
CHAT_DIR=./data/chat
# Discovery state (persistent URL frontier + the DOMAIN registry that discovery
# bootstraps roots from). Both default to a relative data/frontier, which lands
# inside the working directory — set it explicitly so discovery state is durable
# and lives with the rest of the store, not inside the checkout.
FRONTIER_DIR=./data/frontier
RAW_DIR=./data/raw
GRAPHQL_URL=http://localhost:4000/graphql

# Acquisition. `fixture` uses 3 built-in documents and can never reach a
# multi-article target; the job reports it as `sources-exhausted` rather than
# pretending it completed.
#
# CRAWL_URLS is OPTIONAL BOOTSTRAP input, not a required boundary: when empty the
# frontier is NOT cleared and discovery bootstraps from eligible registered
# domains and the adapters below. A BRAND-NEW install still needs at least ONE
# root to start from — set CRAWL_URLS (or CRAWL_DISCOVERY_SEEDS) once; after the
# first cycle the domain registry keeps discovery running without them.
CRAWL_MODE=fixture            # fixture | real
CRAWL_URLS=                   # comma-separated bootstrap seed URLs (optional)

# Discovery policy — which hosts the frontier may fetch beyond the seeds.
#   seeds-only : only bootstrap-source hosts (CRAWL_URLS / discovery seeds /
#                registered domains) — the DEFAULT, and a trap on a fresh host:
#                with an empty CRAWL_URLS it refuses everything that is not a
#                bootstrap root, so cross-host discovery cannot expand.
#   allowlist  : bootstrap hosts + CRAWL_ALLOWED_DOMAINS
#   open       : any host except CRAWL_DENIED_DOMAINS (what a self-hosted
#                instance that genuinely wants to discover uses).
CRAWL_DISCOVERY_POLICY=seeds-only   # seeds-only | allowlist | open
CRAWL_DISCOVERY_ADAPTERS=sitemap,feed   # sitemap,feed[,search]
# Optional extra bootstrap seeds used when CRAWL_URLS is empty.
# These are now fetched as documents (not just adapter roots).
# Set to empty to use CRAWL_DISCOVERY_DEFAULT_SEEDS fallback.
CRAWL_DISCOVERY_SEEDS=
# Built-in bootstrap FALLBACK — used ONLY when nothing else yields a root (no
# CRAWL_URLS, no CRAWL_DISCOVERY_SEEDS, empty domain registry). Lets a brand-new
# install make its first crawl with zero configuration. Set to empty to disable
# and require operator-provided sourcing.
CRAWL_DISCOVERY_DEFAULT_SEEDS=https://en.wikipedia.org/wiki/Steam_engine,https://en.wikipedia.org/wiki/James_Watt,https://en.wikipedia.org/wiki/Recursion,https://en.wikipedia.org/wiki/Photosynthesis

# Language filter (deterministic, dependency-free, opt-in). A document-level
# English gate that is shared by the harvest seam and the ingest backstop. It is
# NOT a domain allow/deny list: English articles on any domain pass, foreign
# articles are excluded regardless of domain. Disabled by default — leave it off
# until the detector has been evaluated on a representative crawl sample.
LANGUAGE_FILTER_ENABLED=false   # master switch; false = detector never runs
LANGUAGE_FILTER_SHADOW=false    # true = detect + report would-be exclusions, change nothing
LANGUAGE_FILTER_MIN_CONFIDENCE=0.8  # 0..1 heuristic starting value, NOT a calibrated accuracy guarantee
LANGUAGE_FILTER_UNKNOWN_POLICY=allow # allow (fail-open, default) | reject

# Servers
API_PORT=4000
CHAT_PORT=8787
# Access token gating /graphql, /admin and the REST surface (CompanionAI-style
# login page + Bearer header). Unset/blank = auth OFF (dev + tests).
SIMPLEMINDS_AUTH_TOKEN=

# Provenance spine (bump when the corresponding implementation changes)
CRITIC_MODEL=
CRITIC_VERSION=critic-v1
RUBRIC_VERSION=rubric-v1
CURRICULUM_VERSION=curriculum-v1
TRAINER_VERSION=stub-v1      # stub-trainer provenance label (only when TRAINER_KIND=stub)
PYTHON_TRAINER_VERSION=python-v1
EVALUATOR_VERSION=eval-v1

TRAINER_KIND=python          # python (default) | stub (explicit, legacy; no backprop)

# Reward
MIN_REWARD=6
# Critic sampling temperature. Recorded in review provenance alongside the model
# and prompt version, so a scoring change is attributable. Lower = more consistent.
CRITIC_TEMPERATURE=0.1
# Critic prompt identity — bump when the wording of CRITIC_PROMPT changes so
# reviews recorded before/after are distinguishable in provenance.
CRITIC_PROMPT_VERSION=critic-prompt-v1

# Synthetic feedback (chat self-harvest)
SYNTHETIC_FEEDBACK=false
SYNTHETIC_MIN_SCORE=8
MAX_SYNTHETIC_SHARE=0.20

# Curriculum constraints (deterministic gate on LLM plan output)
ALLOWED_CATEGORIES=reasoning,coding,general,science,history,howto,fiction,factcheck
CURRICULUM_MAX_SYNTHETIC_SHARE=0.20

# Evaluation + promotion rules (never auto-promote without an eval)
EVAL_DATASET_ID=eval-001
# Advisory only (0 disables): warn when the frozen eval set has fewer documents.
# It NEVER blocks or alters the promotion decision — deliberately non-enforcing.
EVAL_MIN_DOCUMENTS=0
PROMOTE_MIN_DELTA=0        # legacy token-F1 delta (supplementary indicator only)
PROMOTE_MIN_SCORE=0        # legacy token-F1 floor (supplementary indicator only)

# Loss-based promotion gate (AUTHORITATIVE for the real brain)
# improvement = parentLoss - candidateLoss; promote iff improvement >= delta
# AND candidateLoss <= maxLoss AND both losses finite AND same frozen eval set.
PROMOTE_EVAL_SET=./data/evaluation/eval-001.jsonl
PROMOTE_MIN_LOSS_DELTA=0
PROMOTE_MAX_LOSS=Infinity
PROMOTE_REQUIRE_FINITE=true
PROMOTE_EVAL_SEQ_LEN=32
PROMOTE_EVAL_MICRO_BATCH=1

# Training
INIT_CONFIG=small          # sma.brain init --config (random-init architecture)
BATCH_SIZE=64
SNAPSHOT_LIMIT=256
WORKERS=2
RUN_LOCK_STALE_MS=600000   # stale TrainingRun deaths marked failed past this age

# Python trainer hyperparameters (passed to `sma.brain train` by the orchestrator).
# `--lr` has no default in Python on purpose; sourcing it from config keeps it
# explicit and auditable in the Node provenance spine.
TRAIN_LR=1e-4
TRAIN_STEPS=60
TRAIN_SEQ_LEN=128
TRAIN_MICRO_BATCH=2
TRAIN_GRAD_ACCUM=2
TRAIN_WARMUP=10
TRAIN_VAL_BLOCKS=2
TRAIN_COMPUTE_DTYPE=bfloat16   # bfloat16 | float32; use float32 on CPU (bf16 is emulated there)
TRAIN_EVAL_EVERY=10            # record held-out validation loss every N steps (0 = two endpoints only)
TRAIN_TIMEOUT_MS=3600000

# Perpetual loop
PERPETUAL_CYCLES=1
PERPETUAL_IDLE_MS=10000

# Managed lifecycle jobs (Observatory Learning & Training tab)
JOBS_POLL_INTERVAL_MS=60000   # continuous jobs re-check for work this often
JOB_STOP_GRACE_MS=15000       # cooperative-cancel window before force-kill
JOBS_MAX_RUNTIME_MS=0         # hard runtime bound for ANY managed job (0 = unbounded)
LEARNING_TARGET_ARTICLES=100  # bounded learning stops at this many trainable articles
LEARNING_MAX_RAW_DOCS=0       # cap raw docs per bounded run (0 = no cap)
LEARNING_NO_PROGRESS_CYCLES=5 # continuous learning stops after N cycles that acquire nothing (0 disables)
TRAIN_MIN_ELIGIBLE=1          # one-shot training refuses below this many eligible articles
TRAIN_MAX_CONSECUTIVE_REJECTIONS=5 # surface a rejection streak and keep waiting (0 disables)

# --- Disk retention / pruning (see docs/PRUNING.md) ---
# `sma.brain prune-runs` reclaims only `_runs/*.train-state.pt` optimizer-moment
# blobs and is a DRY RUN unless `--confirm` is passed. The active brain and all
# published version directories are never touched.
SMA_PRUNE_KEEP=5             # most recent published versions kept resumable (default 5)
SMA_RUN_LOCK=                # path to the external trainer lock (Node registry RUN.lock);
                             # a live lock refuses destructive pruning. e.g.
                             # /var/lib/simpleminds/data/registry/RUN.lock
SMA_DISK_WARN_PCT=80         # prune-status warning threshold (filesystem used %)
SMA_DISK_CRIT_PCT=90         # prune-status critical threshold (filesystem used %)