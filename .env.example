# --- SimpleMindsAI environment ---
# Phase 1 (62M) is complete; 3B training is Phase 2, perpetual learning Phase 3.
# The authoritative list of variables lives in `src/config.js`; this file is the
# reference example that must stay consistent with it (see docs/DEPLOYMENT.md).

# Python compute plane. The chat brain IS the Python student worker; there is no
# teacher fallback. `SMA_PYTHON`/`SMA_STORE` are also how Node finds the brain.
# SMA_PYTHON=python/python/.venv/Scripts/python.exe   # default: the checkout venv
# SMA_STORE=C:\Users\you\.sma\store                    # default: ~/.sma/store
# SMA_BLUEPRINT=./data/visualisation/brain-blueprint.json  # optional visualiser export
SMA_DEVICE=auto            # auto | cpu | cuda

# Teacher / critic (external researcher & reviewer — NEVER the student's answer)
OLLAMA_ENDPOINT=http://localhost:11434
# On consumer rigs `:latest` is a 4-7GB distill, NOT the 671B MoE. The
# development rig pins the Gemma 4 Turbo teacher (see .env); this reference
# default stays a small distill so a bare checkout works without that model.
OLLAMA_MODEL=deepseek-r1:latest
# Optional pinned teacher identity: readiness reports whether the configured
# model tag resolves to exactly this digest (catches a silent re-tag/substitution).
# OLLAMA_MODEL_DIGEST=
OLLAMA_READINESS_TIMEOUT_MS=5000
# true => deterministic stub for every Ollama call (no GPU needed for smoke/tests)
OLLAMA_FIXTURE=false
# Critic model identifier — when set, overrides the teacher model
  # used specifically for critic scoring in ReviewScorer. When not set,
  # falls back to OLLAMA_MODEL for complete backward compatibility.
  # Set via CRITIC_MODEL env var; records its value in review provenance.
  CRITIC_MODEL=

# Storage. ARTICLE_DIR must be set explicitly: BUFFER_DIR is the LEGACY
# pair-buffer location used only for read-only detection, and the article store
# falls back to it when ARTICLE_DIR is unset. Leaving it unset therefore writes
# the live ledgers into the legacy directory, which makes the Observatory report
# "Legacy pair-buffer files detected" forever and hides the real store.
ARTICLE_DIR=./data/articles
BUFFER_DIR=./data/buffer
REGISTRY_DIR=./data/registry
SNAPSHOT_DIR=./data/snapshots
EVALUATION_DIR=./data/evaluation
PLAN_DIR=./data/plans
MODEL_DIR=./data/models
CHAT_DIR=./data/chat
# Discovery state (persistent URL frontier + the DOMAIN registry that discovery
# bootstraps roots from). Both default to a relative data/frontier, which lands
# inside the working directory — set it explicitly so discovery state is durable
# and lives with the rest of the store, not inside the checkout.
FRONTIER_DIR=./data/frontier
RAW_DIR=./data/raw
GRAPHQL_URL=http://localhost:4000/graphql

# Acquisition. `fixture` uses 3 built-in documents and can never reach a
# multi-article target; the job reports it as `sources-exhausted` rather than
# pretending it completed.
#
# CRAWL_URLS is OPTIONAL BOOTSTRAP input, not a required boundary: when empty the
# frontier is NOT cleared and discovery bootstraps from eligible registered
# domains and the adapters below. A BRAND-NEW install still needs at least ONE
# root to start from — set CRAWL_URLS (or CRAWL_DISCOVERY_SEEDS) once; after the
# first cycle the domain registry keeps discovery running without them.
CRAWL_MODE=fixture            # fixture | real
CRAWL_URLS=                   # comma-separated bootstrap seed URLs (optional)

# Rediscovery & retry scheduling (resilient acquisition). VISITED URLs are
# re-checked after a 7-day TTL using conditional HTTP (ETag / Last-Modified):
# an unchanged page answers 304 and is NOT re-ingested (no duplicate article).
# Due rediscoveries are always claimed AFTER new queued work, so revisiting can
# never starve newly discovered URLs. Failed URLs retry on their own exponential
# backoff (base * 2^(retries-1), capped) and never block other work.
REDISCOVERY_ENABLED=true
REDISCOVERY_TTL_MS=604800000        # 7 days
FRONTIER_RETRY_BACKOFF_BASE_MS=60000
FRONTIER_RETRY_BACKOFF_MAX_MS=3600000

# Mission-driven acquisition (P4). Deterministic templates first: when enabled,
# the active mission statement(s) are turned into bounded search queries by
# src/discovery/mission-queries.js (NO LLM) and appended to CRAWL_SEARCH_QUERIES.
# Derived queries are only candidates — they pass the discovery policy and the
# domain registry like any other candidate, and the search adapter still reports
# `unavailable` without a configured provider. OFF by default.
MISSION_QUERIES_ENABLED=false
MISSION_QUERY_MAX=8
# Advisory mission relevance: compute a lexical overlap score between an ingested
# article and the active mission(s) and persist it as an advisory field. NEVER a
# rejection rule — a low score only deprives an article of a positive
# review-selection hint (REVIEW_MISSION_RELEVANCE). OFF by default.
MISSION_RELEVANCE_ENABLED=false
# Corpus keyphrase queries (P4 keyphrase generator): mine the REVIEWED corpus for
# recurring multi-word phrases and append them as search queries. Advisory only —
# same policy/registry path as every other adapter candidate. OFF by default.
CORPUS_QUERIES_ENABLED=false
CORPUS_QUERY_MAX=20
CORPUS_QUERY_MIN_FREQ=2

# Optional independent search provider (SearXNG or any JSON search API). The
# search adapter is inactive until an endpoint is set; it reports `unavailable`
# otherwise and never requires paid credentials. Enable it by adding `search` to
# CRAWL_DISCOVERY_ADAPTERS. For a self-hosted SearXNG instance:
#   CRAWL_SEARCH_PROVIDER=searxng
#   CRAWL_SEARCH_ENDPOINT=http://localhost:8888/search
#   CRAWL_SEARCH_QUERY_PARAM=q
#   CRAWL_SEARCH_QUERIES=human language,contextual insights
#   CRAWL_SEARCH_EXTRA_PARAMS={"format":"json","safesearch":"1","language":"en"}
# `format=json` is auto-appended for a `searxng` provider; `language=en` biases
# results to English (still subject to the ingest filter on the actual text).
# Multi-provider resilience: list fallback endpoints (comma-separated) tried in
# order when the primary fails; each request is retried CRAWL_SEARCH_MAX_RETRIES
# times. A partially failing pool reports `degraded`; a total failure reports
# `error` (both distinguish it from a valid empty result set). See docs/SEARXNG.md.
CRAWL_SEARCH_PROVIDER=
CRAWL_SEARCH_ENDPOINT=
CRAWL_SEARCH_FALLBACK_ENDPOINTS=
CRAWL_SEARCH_MAX_RETRIES=1
CRAWL_SEARCH_RETRY_DELAY_MS=500
CRAWL_SEARCH_QUERY_PARAM=q
CRAWL_SEARCH_QUERIES=
CRAWL_SEARCH_EXTRA_PARAMS={}

# Admission gateway (durable, sealed per epoch). A rollover seals a new epoch
# under ADMISSION_DIR/epochs/<epoch>/ and atomically switches
# ADMISSION_DIR/ACTIVE_EPOCH.json; the old epoch is never modified.
ADMISSION_DIR=/var/lib/simpleminds/data/gateway
ADMISSION_CAP_LIMIT=500
ADMISSION_CAP_EPOCH=gateway-20261026-01
ADMISSION_ACK_REQUIRED=false
ADMISSION_PROTOCOL_VERSION=baseline-v1
# Rolling policy (only active when ACTIVE_POLICY.json is installed by migration).
ADMISSION_POLICY_VERSION=rolling-v1
ADMISSION_QUOTA_WINDOW_MS=86400000
ADMISSION_QUOTA_LIMIT=50000
ADMISSION_PER_DOMAIN_LIMIT=5000
ADMISSION_PER_DOMAIN_WINDOW_MS=86400000
ADMISSION_RATE_WINDOW_MS=60000
ADMISSION_RATE_LIMIT=2000
ADMISSION_MAX_CONCURRENT=1
# Storage hard stops are disabled (0) until measured production thresholds are
# approved; set both values before enabling the rolling policy.
ADMISSION_STORAGE_MIN_FREE_BYTES=0
ADMISSION_STORAGE_MAX_DB_BYTES=0
ADMISSION_STORAGE_RETRY_MS=60000
ADMISSION_DEFERRAL_RETENTION_MS=604800000
ADMISSION_DEFERRAL_MAX_ROWS=100000
# A full epoch parks the learner; it never marks frontier URLs as rejected.
# The gateway adopts a newly activated pointer on its next authorization.
LEARNING_CAP_WAIT_MS=60000

# HTML extraction strategy.
#   legacy      : original dependency-free tag-stripper (default; no extra deps)
#   readability : @mozilla/readability over jsdom (Apache-2.0 / MIT) — isolates
#                 the main article and drops nav/footer boilerplate. Reversible:
#                 falls back to legacy on any load/parse failure, and unset
#                 reverts to legacy exactly.
EXTRACTION_MODE=legacy        # legacy | readability

# Discovery policy — which hosts the frontier may fetch beyond the seeds.
#   seeds-only : only bootstrap-source hosts (CRAWL_URLS / discovery seeds /
#                registered domains) — the DEFAULT, and a trap on a fresh host:
#                with an empty CRAWL_URLS it refuses everything that is not a
#                bootstrap root, so cross-host discovery cannot expand.
#   allowlist  : bootstrap hosts + CRAWL_ALLOWED_DOMAINS
#   open       : any host except CRAWL_DENIED_DOMAINS (what a self-hosted
#                instance that genuinely wants to discover uses).
CRAWL_DISCOVERY_POLICY=seeds-only   # seeds-only | allowlist | open
CRAWL_DISCOVERY_ADAPTERS=sitemap,feed   # sitemap,feed[,search]
# Governed discovery operations (robots/sitemap/feed network calls). This is a
# separate durable budget from article admission; every adapter request needs a
# recorded grant. Search remains unavailable until separately governed.
DISCOVERY_OPERATIONS_ENABLED=true
DISCOVERY_OPERATIONS_WINDOW_MS=86400000
DISCOVERY_OPERATIONS_MAX_PER_WINDOW=50000
DISCOVERY_OPERATIONS_MAX_PER_DOMAIN=1000
DISCOVERY_OPERATIONS_MAX_CONCURRENT=1
# Optional override; defaults under FRONTIER_DIR/discovery on the durable tree.
# DISCOVERY_DIR=/var/lib/simpleminds/data/frontier/discovery
# Discovery language prior: classify candidate URLs whose HOST declares a
# non-English language (e.g. ca.wikipedia.org) before they are fetched.
#   off | warn (default; enqueue + count) | reject (refuse to enqueue)
# `reject` is recommended for an English-only corpus: foreign-host candidates are
# refused up front. The ingest-time language filter inspects the actual text and
# remains the authoritative, independent backstop.
DISCOVERY_LANGUAGE_PRIOR=warn
# Optional extra bootstrap seeds used when CRAWL_URLS is empty.
# These are now fetched as documents (not just adapter roots).
# Set to empty to use CRAWL_DISCOVERY_DEFAULT_SEEDS fallback.
CRAWL_DISCOVERY_SEEDS=
# Built-in bootstrap FALLBACK — used ONLY when nothing else yields a root (no
# CRAWL_URLS, no CRAWL_DISCOVERY_SEEDS, empty domain registry). Lets a brand-new
# install make its first crawl with zero configuration. Set to empty to disable
# and require operator-provided sourcing.
CRAWL_DISCOVERY_DEFAULT_SEEDS=https://en.wikipedia.org/wiki/Steam_engine,https://en.wikipedia.org/wiki/James_Watt,https://en.wikipedia.org/wiki/Recursion,https://en.wikipedia.org/wiki/Photosynthesis

# Language filter (deterministic, dependency-free, opt-in). A document-level
# English gate that is shared by the harvest seam and the ingest backstop. It is
# NOT a domain allow/deny list: English articles on any domain pass, foreign
# articles are excluded regardless of domain. A source that DECLARES a
# non-English language (<html lang> or a multilingual host such as
# ca.wikipedia.org) is decisive unless the body text is confidently English.
LANGUAGE_FILTER_ENABLED=true    # master switch; default on. false = detector never runs
LANGUAGE_FILTER_SHADOW=false    # true = detect + report would-be exclusions, change nothing
LANGUAGE_FILTER_MIN_CONFIDENCE=0.8  # 0..1 heuristic starting value, NOT a calibrated accuracy guarantee
LANGUAGE_FILTER_UNKNOWN_POLICY=allow # allow (fail-open, default) | reject

# Servers
API_PORT=4000
CHAT_PORT=8787
# Access token gating /graphql, /admin and the REST surface (CompanionAI-style
# login page + Bearer header). Unset/blank = auth OFF (dev + tests).
SIMPLEMINDS_AUTH_TOKEN=

# Provenance spine (bump when the corresponding implementation changes)
CRITIC_MODEL=
CRITIC_VERSION=critic-v1
RUBRIC_VERSION=rubric-v1
CURRICULUM_VERSION=curriculum-v1
TRAINER_VERSION=stub-v1      # stub-trainer provenance label (only when TRAINER_KIND=stub)
PYTHON_TRAINER_VERSION=python-v1
EVALUATOR_VERSION=eval-v1

TRAINER_KIND=python          # python (default) | stub (explicit, legacy; no backprop)

# Reward
MIN_REWARD=6
# Critic sampling temperature. Recorded in review provenance alongside the model
# and prompt version, so a scoring change is attributable. Lower = more consistent.
CRITIC_TEMPERATURE=0.1
# Critic prompt identity — bump when the wording of CRITIC_PROMPT changes so
# reviews recorded before/after are distinguishable in provenance.
CRITIC_PROMPT_VERSION=critic-prompt-v1
# Critic output cap + bounded retry. deepseek-r1 counts hidden chain-of-thought
# against num_predict, so an uncapped critic can loop until Ollama returns
# "token repeat limit reached" and the review is lost. The cap reaches the real
# request (num_predict); 0 disables it.
CRITIC_MAX_TOKENS=512
CRITIC_MAX_ATTEMPTS=2         # bounded retry for a TRANSIENT critic failure (timeout/network/5xx)
CRITIC_REPEAT_PENALTY=1.3     # applied on the retry after a degenerate/repetitive response (1.0 = off)

# Synthetic feedback (chat self-harvest)
SYNTHETIC_FEEDBACK=false
SYNTHETIC_MIN_SCORE=8
MAX_SYNTHETIC_SHARE=0.20

# Curriculum constraints (deterministic gate on LLM plan output)
ALLOWED_CATEGORIES=reasoning,coding,general,science,history,howto,fiction,factcheck
CURRICULUM_MAX_SYNTHETIC_SHARE=0.20

# Evaluation + promotion rules (never auto-promote without an eval)
# eval-002 is the bundled, domain-stratified English Wikipedia baseline committed
# under data/evaluation/. eval-001 is the legacy 5-row seed — loss on it is
# noise-dominated and must not gate promotion.
EVAL_DATASET_ID=eval-002
# Advisory only (0 disables): warn when the frozen eval set is smaller than
# expected, by document count and by a ~4-chars/token estimate. It NEVER blocks
# or alters the promotion decision — deliberately non-enforcing. Recommended:
# EVAL_MIN_TOKENS=20000 so a return to a tiny set warns loudly.
EVAL_MIN_DOCUMENTS=0
EVAL_MIN_TOKENS=0
# Assumed per-token CE std dev, used ONLY to print an estimated standard error of
# the mean loss (sigma/sqrt(tokens)) and a 95% band next to each loss so an
# operator can see when a delta is inside the noise. Never affects promotion.
EVAL_LOSS_TOKEN_STD=3.0
PROMOTE_MIN_DELTA=0        # legacy token-F1 delta (supplementary indicator only)
PROMOTE_MIN_SCORE=0        # legacy token-F1 floor (supplementary indicator only)

# Loss-based promotion gate (AUTHORITATIVE for the real brain)
# improvement = parentLoss - candidateLoss; promote iff improvement >= delta
# AND candidateLoss <= maxLoss AND both losses finite AND same frozen eval set.
PROMOTE_EVAL_SET=./data/evaluation/eval-002.jsonl
# Material threshold: a paired result must beat this even when its CI excludes
# zero. Significance is not usefulness.
PROMOTE_MIN_LOSS_DELTA=0
PROMOTE_MAX_LOSS=Infinity
PROMOTE_REQUIRE_FINITE=true
# Paired uncertainty gate: off | report | enforce. `enforce` requires paired
# per-document evidence and a source-group bootstrap CI excluding zero; without
# it, the outcome is `inconclusive` and the active model does not move.
PROMOTE_UNCERTAINTY_MODE=enforce
PROMOTE_PER_DOCUMENT=true
PROMOTE_MIN_GROUPS=20
PROMOTE_CI_LEVEL=0.95
PROMOTE_BOOTSTRAP_SAMPLES=4000
# Pinned to TRAIN_SEQ_LEN so eval measures the same per-token objective training
# optimises. Changing it changes the metric signature and starts a new,
# incomparable promotion ladder.
PROMOTE_EVAL_SEQ_LEN=128
PROMOTE_EVAL_MICRO_BATCH=2

# Training
INIT_CONFIG=small          # sma.brain init --config (random-init architecture)
BATCH_SIZE=64
SNAPSHOT_LIMIT=256
# SNAPSHOT_INCLUDE_CONSUMED=false: snapshot = the unconsumed delta plus a bounded
# replay share and appended held-out validation rows (default).
# true: legacy full backfill of already-consumed REVIEWED articles up to
# SNAPSHOT_LIMIT. Retained rows still never count as fresh input (see
# freshArticleIds); a run with no fresh rows is refused.
SNAPSHOT_INCLUDE_CONSUMED=false
# 20% of the estimated training tokens may come from consumed, reviewed articles.
# 0 disables replay. Replay rows are never counted as fresh or consumed again.
TRAIN_REPLAY_PERCENT=20
WORKERS=2
RUN_LOCK_STALE_MS=600000   # stale TrainingRun deaths marked failed past this age

# Python trainer hyperparameters (passed to `sma.brain train` by the orchestrator).
# `--lr` has no default in Python on purpose; sourcing it from config keeps it
# explicit and auditable in the Node provenance spine.
TRAIN_LR=1e-4
# Data-derived budget: aim for N passes over the packed training blocks, rounded
# up to whole optimizer steps, then hard-cap so a tiny/static corpus is never
# repeated forever. TRAIN_STEPS is the legacy fallback for trainers without a
# corpus preflight (the stub and injected tests); the Python path replaces it.
TRAIN_TARGET_EPOCHS=2
TRAIN_MAX_STEPS=400
TRAIN_STEPS=60
# Refuse to train below this many unique tokens in the training stream. 0 disables.
TRAIN_MIN_UNIQUE_TOKENS=1700
# Refuse to publish a run that completed fewer optimizer steps than this. 0 disables.
# Set this together with a corpus-sized budget so a 7-27 step update cannot ship.
TRAIN_MIN_STEPS=0
# Corpus text mode. `fragment` keeps the historical curated-text path; `raw-text`
# cleans the fetched source text and falls back to curated text when unavailable.
# Only REVIEWED material enters either mode; curation gates still apply.
TRAIN_CORPUS_MODE=fragment
TRAIN_CORPUS_MIN_CHARS=1000
TRAIN_CORPUS_MIN_SENTENCE_RATIO=0.4
TRAIN_CORPUS_COMMON_LINE_DOCS=10
# Document boundary during packing: separator (concatenate-chunk-v1) or eos
# (concatenate-chunk-v2-eos, inserts the tokenizer EOS after every document).
TRAIN_DOCUMENT_BOUNDARY=separator
# Staged full-corpus candidate profile (validated against v389):
# SNAPSHOT_INCLUDE_CONSUMED=true
# SNAPSHOT_LIMIT=10000
# TRAIN_REPLAY_PERCENT=0
# TRAIN_CORPUS_MODE=raw-text
# TRAIN_MIN_UNIQUE_TOKENS=500000
# TRAIN_MIN_STEPS=1000
# TRAIN_TARGET_EPOCHS=2
# TRAIN_MAX_STEPS=4000
# TRAIN_WARMUP=200
# TRAIN_EVAL_EVERY=100
# TRAIN_DOCUMENT_BOUNDARY=separator
# Best-checkpoint selection: publish the trained checkpoint with the lowest
# in-training held-out validation loss instead of the final step. The frozen
# evaluation set remains the promotion gate; this only chooses the candidate.
TRAIN_SELECT_BEST=true
# Rejected-run cooldown: a rejected batch is deferred for an escalating window
# (base doubles per rejection, capped at max) before it may be re-selected fresh,
# then moves to the replay pool. A rejection never retires/deletes source knowledge.
TRAIN_DEFERRAL_COOLDOWN_BASE_MS=21600000
TRAIN_DEFERRAL_COOLDOWN_MAX_MS=86400000
TRAIN_SEQ_LEN=128
TRAIN_MICRO_BATCH=2
TRAIN_GRAD_ACCUM=2
TRAIN_WARMUP=10
# Held-out validation blocks. When enough consumed rows exist they are appended
# separately, so validation does not reduce the training block count.
TRAIN_VAL_BLOCKS=32
# Deterministic training seed (part of the candidate identity/provenance).
TRAIN_SEED=0
# Validation partitioning. Production default is fail-closed document/source
# disjoint assignment before tokenisation. `legacy-tail-split` is for isolated
# legacy fixtures/tests only and must not be used in production.
TRAIN_VALIDATION_POLICY=document-source-disjoint
# Explicit token target overrides the fraction. When both are 0 the lifecycle
# derives the target from TRAIN_VAL_BLOCKS * TRAIN_SEQ_LEN.
TRAIN_VALIDATION_TARGET_TOKENS=0
TRAIN_VALIDATION_FRACTION=0.05
TRAIN_MIN_VALIDATION_TOKENS=0
TRAIN_MIN_VALIDATION_CLUSTERS=1
TRAIN_VALIDATION_SEED=0
# If true, validation must come only from material that has never been exposed
# to training; corpus-only experiments will fail closed instead of relabelling
# historical exposure as unseen.
TRAIN_VALIDATION_REQUIRE_PROSPECTIVE=true
# Corpus quality/diversity controls. Caps default to disabled (0) and are
# deterministic deferral from the current snapshot, never deletion from the store.
TRAIN_CORPUS_MAX_FALLBACK_TOKEN_SHARE=0
TRAIN_MAX_SOURCE_TOKEN_SHARE=0
TRAIN_MAX_PUBLISHER_TOKEN_SHARE=0
TRAIN_MERGE_SOURCE_RAW_TEXT=true
# Initial English-first corpus policy. Non-English source data is left untouched
# in the article store; it is only ineligible for this corpus.
TRAIN_SUPPORTED_LANGUAGES=en
TRAIN_LANGUAGE_MIN_CONFIDENCE=0.8
TRAIN_LANGUAGE_UNKNOWN_POLICY=allow
TRAIN_COMPUTE_DTYPE=bfloat16   # bfloat16 | float32; use float32 on CPU (bf16 is emulated there)
TRAIN_EVAL_EVERY=10            # record held-out validation loss every N steps (0 = two endpoints only)
TRAIN_TIMEOUT_MS=3600000
# Optional live telemetry (observational only; never affects optimization).
# Python emits one aggregated snapshot per interval over its existing stderr pipe.
TRAIN_TELEMETRY_INTERVAL_MS=1000
TRAIN_TELEMETRY_PUBLISH_MS=1000
TRAIN_TELEMETRY_STALE_MS=5000
TRAIN_TELEMETRY_HISTORY_POINTS=600
# Optional Phase 1.6 prototype: per-block gradient RMS. Off until benchmarked
# on the deployment GPU. Never captures activations or full gradients.
TRAIN_LAYER_ACTIVITY=false
TRAIN_LAYER_ACTIVITY_INTERVAL_MS=2000

# Perpetual loop
PERPETUAL_CYCLES=1
PERPETUAL_IDLE_MS=10000

# Managed lifecycle jobs (Observatory Learning & Training tab)
JOBS_POLL_INTERVAL_MS=60000   # continuous jobs re-check for work this often
JOB_STOP_GRACE_MS=15000       # cooperative-cancel window before force-kill
JOBS_MAX_RUNTIME_MS=0         # hard runtime bound for ANY managed job (0 = unbounded)
LEARNING_TARGET_ARTICLES=100  # bounded learning stops at this many trainable articles
LEARNING_MAX_RAW_DOCS=0       # cap raw docs per bounded run (0 = no cap)
LEARNING_NO_PROGRESS_CYCLES=5 # continuous learning stops after N cycles that acquire nothing (0 disables)
# Acquisition waiting/backoff. A continuous job with no claimable/retryable
# frontier work and no viable provider persists a non-terminal WAITING status
# with `nextAttemptAt` (authoritative; recovered on restart) and backs off
# exponentially — it never declares `sources-exhausted`. The persisted deadline
# is authoritative; the in-memory timer is only an optimisation.
LEARNING_WAIT_BACKOFF_BASE_MS=60000
LEARNING_WAIT_BACKOFF_MAX_MS=3600000
TRAIN_MIN_ELIGIBLE=1          # one-shot training refuses below this many eligible articles
TRAIN_MAX_CONSECUTIVE_REJECTIONS=5 # surface a rejection streak and keep waiting (0 disables)

# Autonomous teacher re-review (both the learning cycle and `npm run review`).
# An inconclusive verdict (uncertain, or a sub-gate approve) leaves the article
# PENDING_REVIEW: it is retried only after COOLDOWN, and RETIRED (an auditable
# terminal transition) after MAX_ATTEMPTS inconclusive attempts. Technical critic
# failures have their own allowance and never consume the inconclusive budget.
REVIEW_COOLDOWN_MS=21600000        # 6h between re-review attempts
REVIEW_MAX_ATTEMPTS=3              # inconclusive attempts before RETIRE
REVIEW_MAX_TECHNICAL_ATTEMPTS=5    # transient critic failures before RETIRE
REVIEW_LOCK_STALE_MS=600000        # REVIEW.lock staleness (serialises reviewers across processes)

# Deterministic review-time QUALITY GATES, run BEFORE the language-blind critic.
# Language is judged on the ACTUAL training text (a valid English translation of
# a foreign-source document PASSES — provenance alone is never a rejection rule),
# and only confidently non-English text is rejected: the gate deliberately does
# NOT apply LANGUAGE_FILTER_UNKNOWN_POLICY, because ambiguous-but-English text
# must not be rejected here. Mission relevance is ADVISORY ONLY and never rejects.
REVIEW_GATES_ENABLED=true          # master switch for both gates
REVIEW_GATE_LANGUAGE=true          # reuse the language filter as a review-time decision
REVIEW_GATE_QUALITY=true           # reject encoding corruption / degenerate repetition
REVIEW_QUALITY_MAX_MOJIBAKE_RATIO=0.02   # char-corruption density above => reject
REVIEW_QUALITY_MIN_BIGRAM_RATIO=0.15     # unique-bigram ratio below (on >=30 words) => reject
# Deterministic COMPLETENESS gate (titles/headings/citations/nav/metadata).
#   shadow  : record the signals on the review record, never change a verdict
#   enforce : reject non-prose before the critic (only after labelled-fixture
#             calibration; see docs/POST_DEPLOYMENT_TRAINING_REVIEW.md)
REVIEW_COMPLETENESS_MODE=shadow

# Critic score => verdict thresholds (reward-scorer.js scoreToVerdict).
#   score <= REVIEW_REJECT_SCORE => REJECT (terminal)
#   score >= REVIEW_MIN_SCORE    => APPROVE
#   otherwise                    => UNCERTAIN (retry, then retire after attempts)
REVIEW_REJECT_SCORE=0           # a critic score of 0 is terminal, never re-reviewed
REVIEW_MIN_SCORE=6

# --- Disk retention / pruning (see docs/PRUNING.md) ---
# `sma.brain prune-runs` reclaims only `_runs/*.train-state.pt` optimizer-moment
# blobs and is a DRY RUN unless `--confirm` is passed. The active brain and all
# published version directories are never touched.
SMA_PRUNE_KEEP=5             # most recent published versions kept resumable (default 5)
SMA_RUN_LOCK=                # path to the external trainer lock (Node registry RUN.lock);
                             # a live lock refuses destructive pruning. e.g.
                             # /var/lib/simpleminds/data/registry/RUN.lock
SMA_DISK_WARN_PCT=80         # prune-status warning threshold (filesystem used %)
SMA_DISK_CRIT_PCT=90         # prune-status critical threshold (filesystem used %)