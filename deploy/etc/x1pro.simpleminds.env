# SimpleMindsAI production environment (X1 Pro Ubuntu)

# --- Servers ---
API_PORT=4000
CHAT_PORT=8787

# --- Storage (absolute; /var/lib/simpleminds) ---
ARTICLE_DIR=/var/lib/simpleminds/data/articles
BUFFER_DIR=/var/lib/simpleminds/data/buffer
REGISTRY_DIR=/var/lib/simpleminds/data/registry
SNAPSHOT_DIR=/var/lib/simpleminds/data/snapshots
EVALUATION_DIR=/var/lib/simpleminds/data/evaluation
PLAN_DIR=/var/lib/simpleminds/data/plans
MODEL_DIR=/var/lib/simpleminds/data/models
CHAT_DIR=/var/lib/simpleminds/data/chat
FRONTIER_DIR=/var/lib/simpleminds/data/frontier
GRAPHQL_URL=http://127.0.0.1:4000/graphql

# --- Python compute plane ---
SMA_PYTHON=/opt/simpleminds/python/.venv/bin/python
SMA_STORE=/var/lib/simpleminds/store
SMA_DEVICE=auto
HF_HOME=/var/lib/simpleminds/.cache/huggingface

# --- Teacher (Ollama) ---
OLLAMA_ENDPOINT=http://127.0.0.1:11434
# Discrepancy RESOLVED: the live ledger (articles.model / reviews.reviewerModel)
# records llama3.2:latest for 2151/2214 articles and 50685/51445 reviews; a small
# early batch (51 articles) used ssfdre38/gemma4-turbo:e4b. The active value below
# matches the majority; the gemma4 tag was an earlier pin, not the current model.
OLLAMA_MODEL=llama3.2:latest
# Optional pinned teacher identity (readiness reports whether the resolved tag
# matches this digest exactly). Leave empty to disable the pin.
OLLAMA_MODEL_DIGEST=
OLLAMA_FIXTURE=false
OLLAMA_READINESS_TIMEOUT_MS=5000

# --- Acquisition ---
CRAWL_MODE=real
CRAWL_URLS=https://en.wikipedia.org/wiki/Artificial_intelligence,https://en.wikipedia.org/wiki/Machine_learning,https://en.wikipedia.org/wiki/Deep_learning,https://en.wikipedia.org/wiki/Natural_language_processing,https://en.wikipedia.org/wiki/Computer_vision,https://en.wikipedia.org/wiki/Data_science,https://en.wikipedia.org/wiki/Quantum_computing,https://en.wikipedia.org/wiki/Blockchain,https://en.wikipedia.org/wiki/Internet_of_things,https://en.wikipedia.org/wiki/Cloud_computing,https://en.wikipedia.org/wiki/Cybersecurity,https://en.wikipedia.org/wiki/Software_engineering,https://en.wikipedia.org/wiki/Database,https://en.wikipedia.org/wiki/Operating_system,https://en.wikipedia.org/wiki/Computer_network,https://en.wikipedia.org/wiki/World_Wide_Web,https://en.wikipedia.org/wiki/Cryptography,https://en.wikipedia.org/wiki/Bioinformatics,https://en.wikipedia.org/wiki/Robotics,https://en.wikipedia.org/wiki/Automation,https://en.wikipedia.org/wiki/History_of_the_World,https://en.wikipedia.org/wiki/Industrial_Revolution,https://en.wikipedia.org/wiki/French_Revolution,https://en.wikipedia.org/wiki/American_Civil_War,https://en.wikipedia.org/wiki/World_War_I,https://en.wikipedia.org/wiki/World_War_II,https://en.wikipedia.org/wiki/Cold_War,https://en.wikipedia.org/wiki/Ancient_Egypt,https://en.wikipedia.org/wiki/Roman_Empire,https://en.wikipedia.org/wiki/Ancient_Greece,https://en.wikipedia.org/wiki/Renaissance,https://en.wikipedia.org/wiki/Age_of_Discovery,https://en.wikipedia.org/wiki/Scientific_Revolution,https://en.wikipedia.org/wiki/Enlightenment,https://en.wikipedia.org/wiki/Globalization,https://en.wikipedia.org/wiki/Earth,https://en.wikipedia.org/wiki/Global_warming,https://en.wikipedia.org/wiki/Photosynthesis,https://en.wikipedia.org/wiki/Evolution,https://en.wikipedia.org/wiki/DNA,https://en.wikipedia.org/wiki/RNA,https://en.wikipedia.org/wiki/Protein,https://en.wikipedia.org/wiki/Cell_(biology),https://en.wikipedia.org/wiki/Human_brain,https://en.wikipedia.org/wiki/Ecosystem,https://en.wikipedia.org/wiki/Solar_System,https://en.wikipedia.org/wiki/Milky_Way,https://en.wikipedia.org/wiki/Universe,https://en.wikipedia.org/wiki/Big_Bang,https://en.wikipedia.org/wiki/Black_hole,https://arxiv.org/abs/1706.03762,https://arxiv.org/abs/2005.14165,https://arxiv.org/abs/2303.08774,https://arxiv.org/abs/1409.0473,https://arxiv.org/abs/1512.03385,https://arxiv.org/abs/1810.04805,https://arxiv.org/abs/1909.11942,https://arxiv.org/abs/2112.10752,https://arxiv.org/abs/2204.02311,https://arxiv.org/abs/2305.10403,https://arxiv.org/abs/1910.13461,https://arxiv.org/abs/2104.08730,https://arxiv.org/abs/2010.11929,https://arxiv.org/abs/2103.00020,https://arxiv.org/abs/2203.11171,https://arxiv.org/abs/2211.05100,https://arxiv.org/abs/2302.04761,https://arxiv.org/abs/2307.09288,https://science.nasa.gov/james-webb-space-telescope,https://science.nasa.gov/hubble-space-telescope,https://science.nasa.gov/mars-exploration-rover-mission,https://science.nasa.gov/artemis-program,https://science.nasa.gov/international-space-telescope,https://science.nasa.gov/kepler-space-telescope,https://science.nasa.gov/voyager-program,https://science.nasa.gov/cassini-huygens,https://science.nasa.gov/juno-mission,https://science.nasa.gov/new-horizons,https://science.nasa.gov/perseverance-rover,https://science.nasa.gov/curiosity-rover,https://science.nasa.gov/parker-solar-probe,https://science.nasa.gov/spitzer-space-telescope,https://science.nasa.gov/chandra-x-ray-observatory,https://journals.plos.org/plosone/
CRAWL_DISCOVERY_POLICY=open
CRAWL_DISCOVERY_SEEDS=
CRAWL_DISCOVERY_DEFAULT_SEEDS=https://en.wikipedia.org/wiki/Steam_engine,https://en.wikipedia.org/wiki/James_Watt,https://en.wikipedia.org/wiki/Recursion,https://en.wikipedia.org/wiki/Photosynthesis
CRAWL_DENIED_DOMAINS=
CRAWL_MAX_DEPTH=2
CRAWL_MAX_LINKS_PER_PAGE=50
# Discovery language prior: classify candidate URLs whose HOST declares a
# non-English language (e.g. ca.wikipedia.org) BEFORE they are fetched.
#   off | warn (enqueue + count) | reject (refuse to enqueue)
# Set to `reject` for English-only discovery: foreign-host candidates are refused
# up front so the crawler never fetches them. The ingest language filter (below)
# remains the authoritative backstop on the actual text.
DISCOVERY_LANGUAGE_PRIOR=reject
# HTML extraction strategy: legacy (dependency-free, default) | readability.
EXTRACTION_MODE=legacy

# --- Ingest language filter (deterministic; the authoritative backstop) ---
# CORRECTION: previously UNSET, so non-English content was never filtered at
# ingest — this is the root cause of the 2015/2214 non-English articles in the
# ledger. `enabled=true` excludes confidently non-English TEXT at ingest (an
# English translation of a foreign source still passes on its English text).
# unknownPolicy=allow keeps the conservative fail-open default for ambiguous
# short text; set `reject` for a stricter policy.
LANGUAGE_FILTER_ENABLED=true
LANGUAGE_FILTER_SHADOW=false
LANGUAGE_FILTER_MIN_CONFIDENCE=0.8
LANGUAGE_FILTER_UNKNOWN_POLICY=allow

# --- Provenance spine ---
CRITIC_MODEL=llama3.2:latest
CRITIC_VERSION=critic-v1
RUBRIC_VERSION=rubric-v1
CURRICULUM_VERSION=curriculum-v1
TRAINER_VERSION=stub-v1
PYTHON_TRAINER_VERSION=python-v1
EVALUATOR_VERSION=eval-v1
# NOTE: BASE_MODEL is NOT read by the code (config.baseModel was removed; the
# effective teacher/curator model is OLLAMA_MODEL and the critic is CRITIC_MODEL,
# falling back to OLLAMA_MODEL). The student's base lineage is tracked in the
# model registry, not via an env var.
TRAINER_KIND=python

# --- Reward ---
MIN_REWARD=6
# Discrepancy RESOLVED: the live review ledger records criticTemperature=0.7
# uniformly (51445 reviews); the previous value here (0.5) was never in effect.
# Kept at 0.7 to match what actually produced the recorded scores.
CRITIC_TEMPERATURE=0.7
CRITIC_PROMPT_VERSION=critic-prompt-v1
# Critic output cap + bounded retry (deepseek-r1-style chain-of-thought can
# otherwise hit "token repeat limit reached" and lose the review).
CRITIC_MAX_TOKENS=512
CRITIC_MAX_ATTEMPTS=2
CRITIC_REPEAT_PENALTY=1.3

# --- Review-time quality gates (deterministic, run BEFORE the critic) ---
# Separates language / quality / mission. Only language and quality can reject;
# mission relevance is advisory and never rejects.
REVIEW_GATES_ENABLED=true
REVIEW_GATE_LANGUAGE=true
REVIEW_GATE_QUALITY=true
REVIEW_QUALITY_MAX_MOJIBAKE_RATIO=0.02
REVIEW_QUALITY_MIN_BIGRAM_RATIO=0.15
# Critic score => verdict thresholds. score <= REJECT_SCORE => terminal REJECT
# (a score of 0 is never re-reviewed); score >= MIN_SCORE => APPROVE; otherwise
# UNCERTAIN (retry, then retire). Fixes the 98% `uncertain` hot loop.
REVIEW_REJECT_SCORE=0
REVIEW_MIN_SCORE=6

# --- Review retry / retirement (explicit; match code defaults for audit) ---
REVIEW_COOLDOWN_MS=21600000
REVIEW_MAX_ATTEMPTS=3
REVIEW_MAX_TECHNICAL_ATTEMPTS=5
REVIEW_LOCK_STALE_MS=600000

# --- Synthetic feedback ---
SYNTHETIC_FEEDBACK=false
SYNTHETIC_MIN_SCORE=8
MAX_SYNTHETIC_SHARE=0.20

# --- Curriculum ---
ALLOWED_CATEGORIES=reasoning,coding,general,science,history,howto,fiction,factcheck
CURRICULUM_MAX_SYNTHETIC_SHARE=0.20

# --- Evaluation + promotion rules (never auto-promote without an eval) ---
# CORRECTION: eval-001 is the legacy 5-row seed and is noise-dominated; promotion
# must gate on eval-002 (60-domain-stratified documents). NOTE: eval-002.jsonl
# must be deployed under /var/lib/simpleminds/data/evaluation/ before this works.
EVAL_DATASET_ID=eval-002
EVAL_MIN_DOCUMENTS=0
EVAL_MIN_TOKENS=20000
EVAL_LOSS_TOKEN_STD=3.0
PROMOTE_MIN_DELTA=0
PROMOTE_MIN_SCORE=0
PROMOTE_EVAL_SET=/var/lib/simpleminds/data/evaluation/eval-002.jsonl
PROMOTE_MIN_LOSS_DELTA=0
PROMOTE_MAX_LOSS=Infinity
PROMOTE_REQUIRE_FINITE=true
# CORRECTION: seq len was 32, but TRAIN_SEQ_LEN is 128 — eval must measure the same
# per-token objective training optimises, or promotion compares incomparable runs.
PROMOTE_EVAL_SEQ_LEN=128
PROMOTE_EVAL_MICRO_BATCH=2
# Promotion fitness (fail-closed): require a minimum eval corpus before a loss is
# trusted to gate promotion.
PROMOTE_EVAL_MIN_BLOCKS=8
PROMOTE_EVAL_MIN_TOKENS=0

# --- Training ---
INIT_CONFIG=small
BATCH_SIZE=64
SNAPSHOT_LIMIT=256
WORKERS=2
RUN_LOCK_STALE_MS=600000

# --- Python trainer hyperparameters ---
TRAIN_LR=1e-4
TRAIN_STEPS=60
TRAIN_SEQ_LEN=128
TRAIN_MICRO_BATCH=2
TRAIN_GRAD_ACCUM=2
TRAIN_WARMUP=10
TRAIN_VAL_BLOCKS=2
TRAIN_COMPUTE_DTYPE=bfloat16
TRAIN_EVAL_EVERY=10
TRAIN_TIMEOUT_MS=3600000

# --- Perpetual loop ---
PERPETUAL_CYCLES=1
PERPETUAL_IDLE_MS=10000

# --- Managed lifecycle jobs ---
JOBS_POLL_INTERVAL_MS=60000
JOB_STOP_GRACE_MS=15000
JOBS_MAX_RUNTIME_MS=0
LEARNING_TARGET_ARTICLES=100
LEARNING_MAX_RAW_DOCS=0
LEARNING_NO_PROGRESS_CYCLES=5
TRAIN_MIN_ELIGIBLE=1
TRAIN_MAX_CONSECUTIVE_REJECTIONS=5

# --- Mission-driven acquisition (P4; OFF by default, advisory) ---
MISSION_QUERIES_ENABLED=false
MISSION_QUERY_MAX=8
MISSION_RELEVANCE_ENABLED=false
# Corpus keyphrase queries (P4 keyphrase generator): mine the REVIEWED corpus for
# recurring multi-word phrases and append them as search queries. Advisory only.
CORPUS_QUERIES_ENABLED=false
CORPUS_QUERY_MAX=20
CORPUS_QUERY_MIN_FREQ=2

# --- Optional independent search provider (SearXNG / any JSON search API) ---
# Inactive until CRAWL_SEARCH_ENDPOINT is set; reports `unavailable` otherwise.
# CRAWL_SEARCH_PROVIDER=searxng
# CRAWL_SEARCH_ENDPOINT=http://127.0.0.1:8888/search
CRAWL_SEARCH_QUERY_PARAM=q
CRAWL_SEARCH_QUERIES=
CRAWL_SEARCH_EXTRA_PARAMS={}

# --- Access token ---
SIMPLEMINDS_AUTH_TOKEN=<TOKEN>
