{
  "name": "simple-minds-ai",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "SimpleMindsAI Node data plane: harvest -> curate -> review -> immutable snapshot -> validated plan -> baseline eval -> train -> candidate eval -> promote/reject, with full provenance. The student is a causal LM pre-trained from random initialization by the Python compute plane in python/; this package owns the corpus and the ledger, never the GPU.",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node src/server.js",
    "chat": "node src/chat/chat-server.js",
    "crawl": "node src/harness/crawler.js",
    "curate": "node src/services/curator.js --file data/raw/sample.ndjson",
    "score": "node src/reward/reward-scorer.js",
    "review": "node src/cli/review.js",
    "admission": "node src/cli/admission.js",
    "eval-cache": "node src/cli/eval-cache.js",
    "plan": "node src/services/planner.js",
    "init:brain": "node src/cli/init-brain.js",
    "train": "node src/cli/train.js",
    "evaluate": "node src/cli/evaluate.js",
    "promote": "node src/cli/promote.js",
    "reject": "node src/cli/reject.js",
    "perpetual": "node src/cli/perpetual.js",
    "blueprint": "node src/cli/blueprint.js",
    "test": "node --test"
  },
  "dependencies": {
    "@apollo/server": "^4.11.0",
    "@mozilla/readability": "^0.6.0",
    "express": "^4.19.2",
    "graphql": "^16.9.0",
    "jsdom": "^30.1.3",
    "three": "^0.180.0"
  }
}
